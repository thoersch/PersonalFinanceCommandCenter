# Postgres connection (Railway injects DATABASE_URL automatically when you add a Postgres service)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_finder
# Set true on Railway's managed Postgres if you connect over the public proxy
DATABASE_SSL=false

# Shared secret the desktop app sends as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
APP_API_TOKEN=change-me

# 32-byte key (hex or base64) used to encrypt API keys stored in the DB. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

PORT=3000
# Set to false to run the API without background workers (e.g. a read-only replica)
WORKERS_ENABLED=true
