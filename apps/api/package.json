{
  "name": "@ff/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "tsc -p tsconfig.json && node --test dist-test/core.spec.js",
    "seed:demo": "node dist/scripts/seed-demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@ff/shared": "*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.0.0",
    "typescript": "5.9.3",
    "drizzle-kit": "^0.31.11"
  }
}